# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
dist/
*.log

# Editor
.vscode/
.idea/
.DS_Store

# Project-specific
none
secrets/
backend/secrets/
downloads/
logs/
.pids/

# Credentials / cookies — NEVER commit these
cookies.txt
*cookie*.txt
secrets/**/*.txt
*.key
*.pem

# Download archives (written by gallery-dl / yt-dlp at runtime)
*.sqlite
*.sqlite-journal
*.db

# Build cache
*.tsbuildinfo

# Agent scratch: local tool config and multi-agent session artifacts.
# Neither belongs in the repo — both are machine-local working state.
.agents/
.cursor/

# Local scratch files from debugging sessions
_t.log
_t.err
_f.log
_f.err
_take/
_diary/
_explored/

# One-off diagnostic scripts from debug sessions. Keep them out of git;
# a real check belongs in backend/tests/ and is named test_*.py.
diag_*.ps1
diag_*.py
diag_*.json
backend/_*.py
backend/_*.ps1
backend/_*.out
backend/_*.err
_*_backend.out
_*_backend.err
_*_frontend.out
_*_frontend.err
# Runtime database + backups/WAL/SHM — never commit
backend/data/
backend/*.log.err