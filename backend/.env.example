# Copy this file to .env and adjust the values for your machine.
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env

# ----- Database -----
# SQLite by default (no Docker needed). For PostgreSQL use:
#   postgresql+asyncpg://USER:PASSWORD@localhost:5432/igdownloader
database_url=sqlite+aiosqlite:///./data/igdownloader.db

# ----- Storage -----
# Per-platform roots. Each platform writes into its own subfolder.
download_folder=E:/gallery-dl/instagram
twitter_download_folder=E:/gallery-dl/twitter
tiktok_download_folder=E:/gallery-dl/tiktok

# Where cookie files are stored (uploaded via the Settings page).
cookie_folder=./secrets/cookies

# ----- Server -----
host=0.0.0.0
port=8000
log_level=INFO

# ----- Security -----
# Fernet key for encrypting cookies at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
cookie_encryption_key=

# ----- Rate limit policy -----
rate_limit_min_delay=18
rate_limit_max_delay=45
rate_limit_batch_size=8
rate_limit_batch_cooldown=240
rate_limit_limit_cooldown=900
rate_limit_max_signals=2

# ----- Job runner -----
max_concurrent_jobs=1
job_lock_timeout_seconds=5